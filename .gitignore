# Videos are ignored by default
*.mp4
*.avi
*.mov
*.mkv

# Allow only approved sample videos
!samples/videos/
!samples/videos/*.mp4

# Temporary files
*.tmp
*.log

!samples/
!samples/videos/
!samples/videos/people_test.mp4