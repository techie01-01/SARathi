# Python cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# VS Code and operating-system files
.vscode/
.DS_Store
Thumbs.db

# Local database
sarathi_incidents.db

# Downloaded model files
yolov8n.pt
*.pt
*.onnx

# Generated detection outputs
outputs/*
